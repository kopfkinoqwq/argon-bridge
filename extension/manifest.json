{
  "manifest_version": 3,
  "name": "Argon Bridge v2.3.3 (Active Anti-Overload & Zombie Watchdog)",
  "version": "2.3.3",
  "description": "Argon Bridge v2.3.3: Active anti-overload watchdog, pre-send zombie stop clearing, one-click session rotate, and passive quota cooling",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1:17420/*",
    "http://localhost:17420/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
