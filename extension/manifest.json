{
  "manifest_version": 3,
  "name": "Argon Bridge v2.3.1 (Anti-Hang Watchdog & Model Guard)",
  "version": "2.3.1",
  "description": "Argon Bridge v2.3.0: 1:1 Project-to-Chat routing, early session binding, zero-reflow streaming, and physical keepalive",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1:17420/*",
    "http://localhost:17420/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
