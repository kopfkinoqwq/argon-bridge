{
  "manifest_version": 3,
  "name": "Argon Bridge v2.3.4 (Precision High-Thinking Dual-Lock)",
  "version": "2.3.4",
  "description": "Argon Bridge v2.3.4: Precision High-Thinking dual-lock, active anti-overload watchdog, pre-send zombie cleanup, and one-click session rotate",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1:17420/*",
    "http://localhost:17420/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
