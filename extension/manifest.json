{
  "manifest_version": 3,
  "name": "Argon Bridge v3.0.0 (Full-Duplex Dual-Brain & Entropy Guard)",
  "version": "3.0.0",
  "description": "Argon Bridge v3.0.0: Full-duplex reverse tool-calling, rolling handover entropy guard, zero-touch clipboard, and O(1) watchdog",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1:17420/*",
    "http://localhost:17420/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "page_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
