{
  "manifest_version": 3,
  "name": "Argon Bridge v2.1 (Auto Model Guard & 1:1 Router)",
  "version": "2.1.0",
  "description": "Bridges local CLI / Google Antigravity with Web Gemini 4 Argon featuring Auto Model Guard and 1:1 Project-to-Chat auto-routing",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1:17420/*",
    "http://localhost:17420/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
