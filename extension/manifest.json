{
  "manifest_version": 3,
  "name": "Argon Bridge v2.3.5 (Single-Action Anti-Duplication)",
  "version": "2.3.5",
  "description": "Argon Bridge v2.3.5: Single-action anti-duplication submission, precision High-Thinking dual-lock, and active zombie watchdog",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1:17420/*",
    "http://localhost:17420/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
